# ------------------------------------------------------------------
# QA JOO environment. Copy to .env.local and fill in what you need.
# Never commit real values: .env* files are git-ignored.
# ------------------------------------------------------------------

# --- Workspace -----------------------------------------------------
# Without Supabase, QA JOO runs on an in-memory store persisted to .data/qa-joo.json.
# Seed the ReviewForge demo project on first start:
QA_JOO_DEMO_MODE=true
# Path for local persistence, or "memory" to disable it.
# QA_JOO_DATA_FILE=.data/qa-joo.json
# Optional overrides for the demo project's targets:
# DEMO_APP_URL=https://reviewforge-agentforge-seoul.vercel.app
# DEMO_REPO_URL=https://github.com/MINJOOOONG/reviewforge-agentforge-seoul

# --- Supabase (Postgres + Auth) ------------------------------------
# When URL + service role key are set, QA JOO stores data in Supabase and requires sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ARTIFACT_BUCKET=qa-artifacts
# QA_JOO_DISABLE_AUTH=false

# --- AI provider ---------------------------------------------------
# anthropic | openai | heuristic. Defaults to whichever key is present, else heuristic (no AI).
AI_PROVIDER=
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# AI_TIMEOUT_MS=90000

# --- Project analyzer ----------------------------------------------
# Allow localhost / private network targets. Only for local development.
ALLOW_PRIVATE_NETWORK_TARGETS=false
# Render pages with Playwright (Chromium) during analysis. Local / self-hosted only.
ANALYZER_BROWSER=false
# Optional GitHub token to raise API rate limits. Only public repositories are read.
GITHUB_TOKEN=

# --- Automation runner ---------------------------------------------
# local (spawn Playwright on this machine) | github (workflow_dispatch) | external (you start the runner)
AUTOMATION_RUNNER=local
# Shared secret for runner callbacks (HMAC). Generate with: openssl rand -hex 32
RUNNER_CALLBACK_SECRET=
# Base URL runners use to reach QA JOO.
QA_JOO_PUBLIC_URL=http://localhost:3000
# GitHub Actions dispatch (AUTOMATION_RUNNER=github)
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REPOSITORY=owner/qa-joo
# GITHUB_DISPATCH_WORKFLOW=qa-automation.yml
# GITHUB_DISPATCH_REF=main
